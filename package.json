{
  "name": "@crypto-jambot/proxy-utils",
  "version": "1.0.0-0",
  "description": "Javascript SDK for ease of communication with JAM etheruem node.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "start": "node .",
    "build": "tsc -p tsconfig.build.json && npm run moveMissingFiles",
    "dev": "nodemon src/server.ts",
    "moveMissingFiles": "cp src/*.d.ts dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crypto-jambot/proxy-utils.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/crypto-jambot/proxy-utils/issues"
  },
  "homepage": "https://github.com/crypto-jambot/proxy-utils#readme",
  "dependencies": {
    "axios": "^1.2.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
